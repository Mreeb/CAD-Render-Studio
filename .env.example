# OpenAI API Key (Required for AI CAD image generation)
OPENAI_API_KEY=sk-proj-your-api-key-here

# Configurable Directory Paths (Defaults will be used if left empty)
EXCEL_FILE=Fiverr List for Auveco-1.xlsx
DATA_DIRECTORY=DATA_DIRECTORY
CAD_REVIEW_DIRECTORY=CAD_REVIEW_DIRECTORY
CAD_DIRECTORY=CAD_DIRECTORY
DATABASE_FILE=cad_manager.db

# Processing Controls
CONFIRMATION_THRESHOLD=10
MAX_CONCURRENT_CONVERSIONS=2
RETRY_COUNT=3
RETRY_BASE_DELAY=2.0
